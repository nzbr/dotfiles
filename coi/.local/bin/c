#!/bin/bash
# vim: syntax=sh
# Attach to the coi session of the current directory, or start a new one.
# Arguments are passed to `coi shell`, so they only apply when no session
# is running yet.
set -euo pipefail

workspace="$(pwd -P)"

# coi reports the workspace as it was resolved when the session started, which
# may or may not have gone through the /home -> /var/home symlink, so compare
# canonicalized paths instead of the strings.
sessions=()
while IFS=$'\t' read -r ws name; do
	[ -n "$name" ] || continue
	[ "$(realpath -m -- "$ws")" == "$workspace" ] || continue
	sessions+=("$name")
done < <(
	coi list --format json |
		jq -r '.active_containers[]? | select((.status // "" | ascii_downcase) == "running") | [.workspace, .name] | @tsv'
)

if [ ${#sessions[@]} -gt 0 ]; then
	if [ ${#sessions[@]} -gt 1 ]; then
		echo "Multiple sessions for this workspace (${sessions[*]}), attaching to ${sessions[0]}" >&2
	fi
	if [ $# -gt 0 ]; then
		echo "Attaching to a running session, ignoring arguments: $*" >&2
	fi
	exec coi attach "${sessions[0]}"
fi

exec coi shell "$@"
